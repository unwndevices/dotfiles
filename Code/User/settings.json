{
  "window.commandCenter": false,
  "editor.fontFamily": "'CommitMono Nerd Font Mono'",
  "editor.fontLigatures": true,
  "editor.fontWeight": "450", // Regular
  "editor.fontSize": 14,
  "editor.indentSize": 4,
  "workbench.sideBar.location": "right",
  "workbench.colorTheme": "Rosé Pine",
  "workbench.iconTheme": "rose-pine-icons",
  "workbench.layoutControl.enabled": false,
  "workbench.tree.indent": 18,
  "explorer.confirmDelete": false,
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "explorer.confirmDragAndDrop": false,
  "git.openRepositoryInParentFolders": "never",
  "phpCodeSniffer.standard": "Automatic",
  "phpCodeSniffer.autoExecutable": true,
  "phpCodeSniffer.lintAction": "Save",
  "[php]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "obliviousharmony.vscode-php-codesniffer",
  },
  "cursor.cmdk.useThemedDiffBackground": true,
  "workspaceExplorer.workspaceStorageDirectory": "$HOME/dev/",
  "workspaceExplorer.enableCustomIconSearch": false,
  "window.customTitleBarVisibility": "never",
  "extensions.ignoreRecommendations": true,
  "workbench.editor.editorActionsLocation": "hidden",
  "cursor.cpp.enablePartialAccepts": true,
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "native",
  "editor.multiCursorModifier": "ctrlCmd",
  "workbench.panel.opensMaximized": "always",
  "terminal.integrated.hideOnStartup": "always",
  "terminal.integrated.fontFamily": "",
  "window.restoreWindows": "none",
  "cursorStats.usageAlertThresholds": [30, 50, 75, 90, 100],
  "editor.quickSuggestionsDelay": 20,
  "clangd.checkUpdates": true,
  "clangd.onConfigChanged": "restart",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "sortEditors.sortEditorsOrder": "alphabetical",
  "[cpp]": {
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true,
    "editor.stickyScroll.defaultModel": "foldingProviderModel",
    "editor.suggest.insertMode": "replace",
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "diffEditor.maxComputationTime": 0,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "cursor.cpp.disabledLanguages": ["plaintext"],
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "terminal.external.linuxExec": "kitty",
  "terminal.explorerKind": "external",
  "supermaven.enable": {
    "*": false,
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
  },
  "chat.tools.terminal.autoApprove": {
    "flutter": true,
    "dart": true,
  },
  "chat.editing.confirmEditRequestRemoval": false,
  "claude-code.environmentVariables": [
    {
      "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
      "ANTHROPIC_AUTH_TOKEN": "cab9049687a34d4386300921d10face6.tuZoWDZMbQjllo3k",
    },
  ],
  "github.copilot.nextEditSuggestions.enabled": true,
  "kilo-code.allowedCommands": [
    "git log",
    "git diff",
    "git show",
    "cd eisei/daisy",
    "make",
    "cd",
    "make 2>&1",
    "grep -E \"(normalization|DaisyEisei|CV_IN_4|CV_ORBIT)\"",
    "echo \"No normalization-related errors found\"",
    "make 2",
    "make 2 1",
    "grep",
    "echo",
    "tail",
    "tail -20",
    "git add docs/sines/",
    "git",
    "git add",
    "git status",
    "git commit -m Add comprehensive planning for bank-specific sine oscillator implementation",
    "git log --oneline --since=\"2024-01-01\" --grep=\"v0.1.7\" --invert-grep",
    "head -20",
    "head",
    "npm run build",
    "cd bloom-admin-dashboard",
    "npm",
    "npm run",
    "npm install",
    "npm audit fix",
    "npm audit",
    "dart",
    "dart run build_runner build --delete-conflicting-outputs",
    "dart run",
    "dart run build_runner",
    "flutter",
    "flutter analyze",
    "flutter analyze --fatal-warnings lib/src/features/plants/presentation/providers/plant_catalog_provider.dart",
    "pypr --version 2>&1",
    "which pypr 2",
    "which pypr",
    "which",
    "pyprland",
    "pypr",
    "which pypr 2>&1",
    "pyprland --version 2>&1",
    "ls -la glob",
    "ls",
    "grep pypr",
    "ls -la /usr/lib/python3.14/site-packages/",
    "find",
    "find glob",
  ],
  "kilo-code.deniedCommands": [],
}
